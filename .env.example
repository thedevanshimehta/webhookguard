# Copy to .env and fill in. Never commit .env.
# Variable names are a starting point; final names are fixed in docs/api-contract.md (task T02/T03).

# Key management (format: key_id:secret, comma separated; first = active signing key)
WEBHOOKGUARD_KEYS=k1:change-me-to-a-long-random-string

# Freshness window in seconds (5 minutes)
TIMESTAMP_WINDOW_SECONDS=300

# Event store: "sqlite" (default) or "redis"
EVENT_STORE=sqlite
SQLITE_PATH=./webhookguard.db
REDIS_URL=redis://localhost:6379/0

# Security log output (JSON lines)
LOG_PATH=./logs/security.jsonl
