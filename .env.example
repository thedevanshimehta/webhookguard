
# Generate a real secret with:  python -m keys.key_manager
# The placeholder below is refused on purpose. Never commit .env
WEBHOOKGUARD_KEYS=k1:replace-with-a-long-random-secret

TIMESTAMP_WINDOW_SECONDS=300

# Supported: sqlite, redis, memory
EVENT_STORE=sqlite
EVENT_STORE_PATH=data/events.db
REDIS_URL=redis://localhost:6379/0

LOG_PATH=logs/security.jsonl

# Largest accepted webhook body in bytes (default 1 MiB); larger -> 413 too_large
MAX_BODY_BYTES=1048576

# Where python -m app.main listens (default loopback only)
HOST=127.0.0.1
PORT=5000
